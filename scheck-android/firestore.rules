rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function role() { return get(/databases/$(db)/documents/users/$(request.auth.uid)).data.role; }
    function signedIn() { return request.auth != null; }
    match /users/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || role() == 'ADMIN');
      allow write: if signedIn() && role() == 'ADMIN';
    }
    match /products/{id} {
      allow read: if signedIn();
      allow create, delete: if role() == 'ADMIN';
      // Personel yalnızca stok düşümü yapabilir.
      allow update: if role() == 'ADMIN' || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
        && request.resource.data.stock < resource.data.stock);
    }
    match /sales/{id} {
      allow create: if signedIn() && request.resource.data.cashierUid == request.auth.uid;
      allow read: if role() == 'ADMIN';
    }
  }
}
